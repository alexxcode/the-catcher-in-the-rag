# ── The Catcher in the RAG — environment configuration ───────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored. Never commit secrets.

# ── GCP ───────────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=the-catcher-in-the-rag
GOOGLE_CLOUD_REGION=us-central1
# ADC is used for auth; no API key needed locally.
# Run: gcloud auth application-default login

# ── Cloud SQL (PostgreSQL + pgvector) ─────────────────────────────────────────
# Connection via Cloud SQL Auth Proxy (recommended locally):
#   cloud-sql-proxy the-catcher-in-the-rag:us-central1:catcher-pg-dev
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=catcher
DB_USER=catcher_user
DB_PASSWORD=           # set locally; in GCP read from Secret Manager

# ── Langfuse (tracing) ────────────────────────────────────────────────────────
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=    # from Langfuse project settings
LANGFUSE_SECRET_KEY=    # from Langfuse project settings

# ── Provider selection ────────────────────────────────────────────────────────
# "real" uses Gemini/Vertex AI; "stub" runs offline deterministically.
LLM_PROVIDER=real
EMBEDDING_PROVIDER=real

# ── GCS buckets ───────────────────────────────────────────────────────────────
GCS_DOCUMENTS_BUCKET=the-catcher-in-the-rag-documents
GCS_REPORTS_BUCKET=the-catcher-in-the-rag-reports
